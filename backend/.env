# ==============================================================================
# StatSkill AI - Environment Configuration Template
# ==============================================================================

# Application Configuration
APP_NAME="StatSkill AI"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api"
DEMO_MODE=True

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=statskill
POSTGRES_PASSWORD=statskill_secret
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=statskill_db
DATABASE_URL=postgresql://statskill:statskill_secret@localhost:5432/statskill_db

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_statskill_ai_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector DB / pgvector
VECTOR_DIMENSION=384

# Frontend URL / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
